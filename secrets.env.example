# Server only. Do NOT upload a completed copy to GitHub. No credentials are supplied here.
SITE_URL=https://cadeakram72-svg.github.io/Akramlibrary.github.io/
PAYMENTS_ENABLED=false
PAYMENT_MODE=test
# Supabase automatically supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Stripe: only for an approved merchant in a supported country.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# WAAFI merchant HPP credentials, not a personal EVC number or PIN.
WAAFI_MERCHANT_UID=
WAAFI_STORE_ID=
WAAFI_HPP_KEY=
WAAFI_WEBHOOK_SECRET=
WAAFI_API_URL=https://sandbox.waafipay.com/asm
# Switch to https://api.waafipay.net/asm only with PAYMENT_MODE=live and approved live credentials.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend; gmail.com cannot be verified by this project.
RECEIPT_FROM=
# Generate a long random secret locally. Store the same value in Supabase Vault for the job.
CRON_SECRET=
